{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Public and career training progress profile for a registered candidate across JANKEN CORPS and HOTBURN STUDIOS.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the owner",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Display name of the learner",
          "minLength": 1,
          "maxLength": 100
        },
        "handle": {
          "type": "string",
          "description": "Public handle",
          "minLength": 1,
          "maxLength": 60
        },
        "selectedCompany": {
          "type": "string",
          "enum": ["JANKEN CORPS", "HOTBURN STUDIOS"],
          "description": "Currently active training company"
        },
        "targetRole": {
          "type": "string",
          "description": "Selected career track title",
          "minLength": 2,
          "maxLength": 120
        },
        "eloRating": {
          "type": "number",
          "description": "Candidate skill rating"
        },
        "globalReadinessScore": {
          "type": "number",
          "description": "Overall readiness percentage (0-100)"
        },
        "xp": {
          "type": "number",
          "description": "Total earned experience points"
        },
        "dossierHash": {
          "type": "string",
          "description": "Verification hash for candidate dossier",
          "minLength": 4,
          "maxLength": 64
        },
        "completedModuleIds": {
          "type": "string",
          "description": "Comma-separated list of completed course module IDs",
          "maxLength": 2000
        },
        "passedQuizIds": {
          "type": "string",
          "description": "Comma-separated list of passed quiz IDs",
          "maxLength": 2000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp"
        }
      },
      "required": [
        "uid",
        "name",
        "handle",
        "selectedCompany",
        "targetRole",
        "eloRating",
        "globalReadinessScore",
        "xp",
        "dossierHash",
        "completedModuleIds",
        "passedQuizIds",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Isolated PII document storing the user's email address.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 254
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "EmailInquiry": {
      "title": "EmailInquiry",
      "description": "Email query dispatched to hotburnstudios@gmail.com for JANKEN CORPS and HOTBURN STUDIOS.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "UID of the authenticated sender",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "company": {
          "type": "string",
          "enum": ["JANKEN CORPS", "HOTBURN STUDIOS"],
          "description": "Primary selected company context"
        },
        "recipientEmail": {
          "type": "string",
          "enum": ["hotburnstudios@gmail.com"],
          "description": "Unified destination email for both companies"
        },
        "senderName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "senderEmail": {
          "type": "string",
          "minLength": 3,
          "maxLength": 254
        },
        "topic": {
          "type": "string",
          "minLength": 2,
          "maxLength": 200
        },
        "message": {
          "type": "string",
          "minLength": 2,
          "maxLength": 4000
        },
        "dossierHash": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64
        },
        "status": {
          "type": "string",
          "enum": ["SENT_TO_HOTBURNSTUDIOS_GMAIL"],
          "description": "Immutable terminal dispatch status"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "company",
        "recipientEmail",
        "senderName",
        "senderEmail",
        "topic",
        "message",
        "dossierHash",
        "status",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Stores each learner's career training state, chosen company, career track, and completed modules."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Isolated PII subcollection storing the user's private email address."
    },
    "/inquiries/{inquiryId}": {
      "schema": { "$ref": "#/entities/EmailInquiry" },
      "description": "Stores queries dispatched to hotburnstudios@gmail.com for both JANKEN CORPS and HOTBURN STUDIOS."
    }
  }
}
